diff --git a/tests/test_pluck.py b/tests/test_pluck.py
new file mode 100644
index 0000000..233229b
--- /dev/null
+++ b/tests/test_pluck.py
@@ -0,0 +1,14 @@
+from tinydb import TinyDB
+from tinydb.storages import MemoryStorage
+
+
+def test_pluck_names():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple([{'name': 'a'}, {'name': 'b'}, {'name': 'c'}])
+    assert db.pluck('name') == ['a', 'b', 'c']
+
+
+def test_pluck_other_table():
+    db = TinyDB(storage=MemoryStorage)
+    db.table('users').insert({'email': 'x@example.com'})
+    assert db.table('users').pluck('email') == ['x@example.com']
diff --git a/tinydb/table.py b/tinydb/table.py
index 76470aa..4ccd090 100644
--- a/tinydb/table.py
+++ b/tinydb/table.py
@@ -852,3 +852,14 @@ class Table:
 
         # Clear the query cache, as the table contents have changed
         self.clear_cache()
+
+    def pluck(self, field: str) -> list:
+        """
+        Get the value of ``field`` from every document, in insertion order.
+
+        Documents that do not have the field are skipped.
+
+        :param field: the name of the field
+        :returns: a list of the field's values
+        """
+        return [doc.get(field) for doc in self._read_table().values()]
